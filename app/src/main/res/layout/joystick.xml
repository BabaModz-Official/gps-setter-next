<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/joystick_root"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:background="@drawable/joystick_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Row 1: Dedicated Draggable Header Bar -->
    <LinearLayout
        android:id="@+id/joystick_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <!-- Title & Drag Handle (large touch target) -->
        <TextView
            android:id="@+id/tv_joystick_title"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="⠿ GPS Next"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_minimize_joystick"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron"
            custom:tint="#FFAAAAAA"
            android:contentDescription="Minimize" />

        <ImageView
            android:id="@+id/btn_close_joystick"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            custom:tint="#FFAAAAAA"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Row 2: Status & Quick Controls Bar -->
    <LinearLayout
        android:id="@+id/joystick_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_joystick_cooldown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="Safe" />

        <TextView
            android:id="@+id/tv_joystick_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#3D82F6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="5 m/s" />

        <TextView
            android:id="@+id/btn_joystick_opacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:text="100%" />
    </LinearLayout>

    <!-- Row 3: Joystick Body (Collapsible) -->
    <LinearLayout
        android:id="@+id/joystick_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Virtual Joystick -->
        <io.github.jqssun.gpssetter.ui.ThumbstickView
            android:id="@+id/joystickView_right"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/joystick_direction" />

        <!-- Speed Mode Selectors -->
        <LinearLayout
            android:id="@+id/joystick_speed_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/btn_speed_walk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Walk"
                android:textColor="#3D82F6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_speed_run"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Run"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btn_speed_drive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Drive"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
